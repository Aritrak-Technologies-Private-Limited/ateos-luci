config service 'main'
	option enabled '0'
	option interval '60'
	option dedupe_window '300'
	option spool_dir '/var/run/event-notifier'
	option event_log '/var/log/event-notifier.log'

config trigger 'offline'
	option enabled '1'
	option type 'offline'
	option severity 'critical'
	option interface 'wan'
	list host '8.8.8.8'
	list host '1.1.1.1'
	option check_interval '30'
	option timeout '5'
	option failures '3'
	list channel 'email'
	list channel 'sms'

config trigger 'latency'
	option enabled '1'
	option type 'latency'
	option severity 'warning'
	option target '8.8.8.8'
	option latency_high '250'
	option latency_low '150'
	option samples '5'
	list channel 'email'

config trigger 'speed_threshold'
	option enabled '0'
	option type 'speed_threshold'
	option severity 'warning'
	option interface 'wan'
	option direction 'rx'
	option comparator 'below'
	option threshold_kbps '1024'
	option window '60'
	list channel 'email'

config trigger 'sim_tampering'
	option enabled '0'
	option type 'sim_tampering'
	option severity 'critical'
	option at_port 'auto'
	option status_source 'qtcm'
	option gcom_dir '/usr/share/qtcm-gcom'
	option iccid_script 'iccid.qtcmgcom'
	option imsi_script 'imsi.qtcmgcom'
	option imei_script 'imei.qtcmgcom'
	option expected_iccid ''
	option expected_imsi ''
	option expected_imei ''
	list channel 'email'
	list channel 'sms'

config event 'ssh_login'
	option enabled '1'
	option type 'ssh_login'
	option severity 'warning'
	option source 'syslog'
	option service 'dropbear'
	option match_success '1'
	option match_failure '1'
	option include_root '1'
	option include_non_root '1'
	list channel 'email'

config event 'telnet_login'
	option enabled '1'
	option type 'telnet_login'
	option severity 'critical'
	option source 'syslog'
	option service 'telnet'
	option match_success '1'
	option match_failure '1'
	option include_root '1'
	option include_non_root '1'
	list channel 'email'
	list channel 'sms'

config event 'local_user_login'
	option enabled '1'
	option type 'local_user_login'
	option severity 'warning'
	option source 'syslog'
	option include_root '0'
	option include_non_root '1'
	list channel 'email'

config event 'hotplug'
	option enabled '0'
	option type 'hotplug'
	option severity 'info'
	option source 'hotplug'
	list subsystem 'iface'
	list subsystem 'net'
	list channel 'email'

config event 'ethernet_link'
	option enabled '1'
	option type 'ethernet_link'
	option severity 'info'
	option source 'netlink'
	option interface '*'
	option match_plugged '1'
	option match_unplugged '1'
	list channel 'email'

config email_api 'email'
	option enabled '0'
	option url ''
	option key ''
	option shared_secret ''
	option verify_ssl '1'
	option connect_timeout '15'
	option max_time '30'
	option from ''

config sms_api 'sms'
	option enabled '0'
	option url ''
	option key ''
	option shared_secret ''
	option verify_ssl '1'
	option connect_timeout '15'
	option max_time '30'
	option sender ''
