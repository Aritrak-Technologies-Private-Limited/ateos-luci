config service 'main'
	option enabled '0'
	option interval '60'
	option dedupe_window '300'
	option spool_dir '/var/run/event-notifier'
	option event_log '/var/log/event-notifier.log'

config trigger 'offline'
	option enabled '1'
	option type 'offline'
	option severity 'critical'
	list interface 'wan'
	list host '8.8.8.8'
	list host '1.1.1.1'
	option check_interval '30'
	option timeout '5'
	option failures '3'
	list channel 'email'
	list channel 'sms'

config trigger 'latency'
	option enabled '1'
	option type 'latency'
	option severity 'warning'
	option target '8.8.8.8'
	option latency_high '250'
	option latency_low '150'
	option samples '5'
	list channel 'email'

config trigger 'speed_threshold'
	option enabled '0'
	option type 'speed_threshold'
	option severity 'warning'
	list interface 'wan'
	option direction 'rx'
	option comparator 'below'
	option threshold_kbps '1024'
	option window '60'
	list channel 'email'

config trigger 'sim_tampering'
	option enabled '0'
	option type 'sim_tampering'
	option severity 'critical'
	option at_port 'auto'
	option status_source 'qtcm'
	option gcom_dir '/etc/gcom'
	option iccid_script 'iccid.gcom'
	option imsi_script 'imsi.gcom'
	option imei_script 'imei.gcom'
	option expected_iccid ''
	option expected_imsi ''
	option expected_imei ''
	list channel 'email'
	list channel 'sms'

config event 'login'
	option enabled '1'
	option type 'login'
	option severity 'warning'
	option source 'syslog'
	list login_method 'ssh'
	list login_method 'telnet'
	list login_method 'local_user'
	option match_success '1'
	option match_failure '1'
	option include_root '1'
	option include_non_root '1'
	list channel 'email'
	list channel 'sms'

config event 'hotplug'
	option enabled '0'
	option type 'hotplug'
	option severity 'info'
	option source 'hotplug'
	list subsystem 'iface'
	list subsystem 'net'
	list channel 'email'

config event 'netifd_interface'
	option enabled '1'
	option type 'netifd_interface'
	option severity 'info'
	option source 'netifd'
	list interface 'wan'
	list interface 'wan2'
	list state 'up'
	list state 'down'
	list channel 'email'

config event 'ethernet_link'
	option enabled '1'
	option type 'ethernet_link'
	option severity 'info'
	option source 'netlink'
	list interface '*'
	option match_plugged '1'
	option match_unplugged '1'
	list channel 'email'

config event 'luci_login'
	option enabled '1'
	option type 'luci_login'
	option severity 'warning'
	option source 'syslog'
	option match_success '1'
	option match_failure '1'
	list channel 'email'

config event 'firewall_security'
	option enabled '0'
	option type 'firewall_security'
	option severity 'warning'
	option source 'syslog'
	list category 'firewall'
	list category 'banip'
	list category 'drop'
	list channel 'email'

config event 'service_health'
	option enabled '0'
	option type 'service_health'
	option severity 'warning'
	option source 'syslog'
	list service 'qconnect'
	list service 'qtcm'
	list service 'network'
	option match_restart '1'
	option match_crash '1'
	option match_error '1'
	list channel 'email'

config event 'dhcp_lease'
	option enabled '0'
	option type 'dhcp_lease'
	option severity 'info'
	option source 'syslog'
	list interface 'lan'
	option match_add '1'
	option match_remove '1'
	list channel 'email'

config event 'vpn_state'
	option enabled '0'
	option type 'vpn_state'
	option severity 'warning'
	option source 'syslog'
	list vpn 'wireguard'
	list vpn 'openvpn'
	list vpn 'ipsec'
	option match_up '1'
	option match_down '1'
	list channel 'email'

config event 'sim_service'
	option enabled '1'
	option type 'sim_service'
	option severity 'warning'
	option source 'syslog'
	list service 'qconnect'
	list service 'qtcm'
	option match_error '1'
	option match_restart '1'
	list channel 'email'
	list channel 'sms'

config event 'dns_network'
	option enabled '0'
	option type 'dns_network'
	option severity 'warning'
	option source 'syslog'
	list category 'dns'
	list category 'resolver'
	list category 'network'
	option match_failure '1'
	option match_recovery '1'
	list channel 'email'

config email_api 'email'
	option enabled '0'
	option url ''
	option key ''
	option shared_secret ''
	option verify_ssl '1'
	option connect_timeout '15'
	option max_time '30'
	option from ''

config sms_api 'sms'
	option enabled '0'
	option url ''
	option key ''
	option shared_secret ''
	option verify_ssl '1'
	option connect_timeout '15'
	option max_time '30'
	option sender ''
