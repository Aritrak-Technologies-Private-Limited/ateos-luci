#!/bin/sh

POLL_PID=""
LOGWATCH_PID=""
NETIFD_PID=""

start_named_child() {
	local name="$1"
	local cmd="$2"
	local pid

	[ -x "$cmd" ] || return 0
	"$cmd" &
	pid="$!"
	eval "${name}_PID=$pid"
}

ensure_child() {
	local name="$1"
	local cmd="$2"
	local pid

	eval "pid=\$${name}_PID"
	if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then
		start_named_child "$name" "$cmd"
	fi
}

stop_children() {
	[ -n "$POLL_PID" ] && kill "$POLL_PID" 2>/dev/null
	[ -n "$LOGWATCH_PID" ] && kill "$LOGWATCH_PID" 2>/dev/null
	[ -n "$NETIFD_PID" ] && kill "$NETIFD_PID" 2>/dev/null
	wait
	exit 0
}

trap stop_children INT TERM

while true; do
	ensure_child POLL /usr/libexec/event-notifier-poll
	ensure_child LOGWATCH /usr/libexec/event-notifier-logwatch
	ensure_child NETIFD /usr/libexec/event-notifier-netifd
	sleep 5
done
