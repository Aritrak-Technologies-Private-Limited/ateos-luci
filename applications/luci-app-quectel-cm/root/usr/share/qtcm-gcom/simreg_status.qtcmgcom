opengt
 set com 115200n81
 set comecho off
 set senddelay 0.02
 waitquiet 0.2 0.2
 flash 0.1

:start
 send "AT+CEREG?^m"
 waitfor 5 "+CEREG:","ERROR"
 if % = 0 goto print_cereg
 goto gprs

:print_cereg
 get 1 "^m" $n
 print "+CEREG:",$n,"\n"

:gprs
 send "AT+CGREG?^m"
 waitfor 5 "+CGREG:","ERROR"
 if % = 0 goto print_cgreg
 goto cs

:print_cgreg
 get 1 "^m" $n
 print "+CGREG:",$n,"\n"

:cs
 send "AT+CREG?^m"
 waitfor 5 "+CREG:","ERROR"
 if % = 0 goto print_creg
 goto continue

:print_creg
 get 1 "^m" $n
 print "+CREG:",$n,"\n"


:continue
 exit 0
