opengt
 set com 115200n81
 set comecho off
 set senddelay 0.02
 waitquiet 0.2 0.2
 flash 0.1

:start
 send "AT+QSPN^m"
 waitfor 5 "+QSPN:","ERROR"
 if % = 0 goto print_qspn
 goto cops

:print_qspn
 get 1 "^m" $n
 print "+QSPN:",$n,"\n"

:cops
 send "AT+COPS=3,0^m"
 waitfor 5 "OK","ERROR"
 send "AT+COPS?^m"
 waitfor 10 "+COPS:","ERROR"
 if % = 0 goto print_cops
 goto continue

:print_cops
 get 1 "^m" $n
 print "+COPS:",$n,"\n"

:continue
 exit 0
