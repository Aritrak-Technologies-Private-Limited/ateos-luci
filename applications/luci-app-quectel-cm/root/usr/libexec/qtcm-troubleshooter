#!/bin/sh

NAME="qtcm-troubleshooter"
STATE_DIR="/tmp/qtcm-troubleshooter"

log() {
	logger -t "$NAME" "$*"
}

read_uci() {
	uci -q get "$1" 2>/dev/null
}

cfg() {
	local option="$1"
	local fallback="$2"
	local value

	value="$(read_uci "qtcm.troubleshoot.$option")"
	[ -n "$value" ] && printf '%s' "$value" || printf '%s' "$fallback"
}

fail_count_option() {
	case "$1" in
		sim_error) printf '%s' "sim_error_fail_count" ;;
		modem_unresponsive) printf '%s' "modem_response_fail_count" ;;
		interface_no_ip) printf '%s' "interface_ip_fail_count" ;;
		registration_failed) printf '%s' "registration_fail_count" ;;
		internet_failure|post_failover_failure) printf '%s' "ping_fail_count" ;;
		*) printf '%s' "sim_error_fail_count" ;;
	esac
}

check_enabled() {
	case "$1" in
		sim_error) [ "$(cfg check_sim_error 1)" = "1" ] ;;
		modem_unresponsive) [ "$(cfg check_modem_response 1)" = "1" ] ;;
		interface_no_ip) [ "$(cfg check_interface_ip 1)" = "1" ] ;;
		registration_failed) [ "$(cfg check_registration 1)" = "1" ] ;;
		internet_failure|post_failover_failure) [ "$(cfg check_ping 1)" = "1" ] ;;
		*) return 0 ;;
	esac
}

event_action_prefix() {
	case "$1" in
		sim_error) printf '%s' "sim_error" ;;
		modem_unresponsive) printf '%s' "modem_response" ;;
		interface_no_ip) printf '%s' "interface_ip" ;;
		registration_failed) printf '%s' "registration" ;;
		internet_failure|post_failover_failure) printf '%s' "ping" ;;
		*) printf '%s' "$1" ;;
	esac
}

action_for_event_step() {
	local event="$1"
	local step="$2"
	local prefix action

	prefix="$(event_action_prefix "$event")"
	action="$(read_uci "qtcm.troubleshoot.${prefix}_action_${step}")"
	[ -n "$action" ] || action="$(cfg "action_$step" '')"
	printf '%s' "$action"
}

active_sim() {
	local sim

	sim="$(read_uci qtcm.main.active_sim)"
	[ "$sim" = "2" ] && printf '2' || printf '1'
}

other_sim() {
	[ "$1" = "1" ] && printf '2' || printf '1'
}

sim_enabled() {
	[ "$(read_uci "qtcm.sim${1}.enabled")" = "1" ]
}

restart_qtcm() {
	log "recovery action: restart qtcm"
	[ -x /etc/init.d/qtcm ] && /etc/init.d/qtcm restart >/dev/null 2>&1
}

restart_gpio_switch() {
	[ -x /etc/init.d/gpio_switch ] && /etc/init.d/gpio_switch restart >/dev/null 2>&1
}

set_switch_value() {
	local name="$1"
	local value="$2"

	uci -q set "system.${name}.value=${value}" || return 1
	uci -q commit system || return 1
	restart_gpio_switch
}

power_cycle_mpcie() {
	log "recovery action: power-cycle mPCIe"
	set_switch_value power_mpcie 0 || return 1
	sleep 3
	set_switch_value power_mpcie 1
}

switch_sim() {
	local old new

	old="$(active_sim)"
	new="$(other_sim "$old")"

	sim_enabled "$new" || {
		log "recovery action switch_sim skipped: SIM $new disabled"
		return 1
	}

	log "recovery action: switch SIM $old -> $new"
	uci -q set "qtcm.main.active_sim=$new" || return 1
	uci -q commit qtcm || return 1

	if [ -x /etc/qtcm_custom_failover_script.sh ]; then
		NEW_SIM="$new" OLD_SIM="$old" SWITCH_REASON="troubleshooter recovery" ACTIVE_INTERFACE="" SIGNAL_DBM="" \
			/etc/qtcm_custom_failover_script.sh "$new" "$old" "troubleshooter recovery" "" "" || return 1
	fi

	restart_qtcm
}

run_action() {
	case "$1" in
		restart_qtcm)
			restart_qtcm
			;;
		power_cycle_mpcie)
			power_cycle_mpcie
			;;
		switch_sim)
			switch_sim
			;;
		reboot_router)
			log "recovery action: reboot router"
			/sbin/reboot
			;;
		''|none)
			log "recovery action: none"
			;;
		*)
			log "unknown recovery action '$1'"
			return 1
			;;
	esac
}

event_file_name() {
	printf '%s' "$1" | tr -c 'A-Za-z0-9_' '_'
}

handle_event() {
	local event="$1"
	local detail="$2"
	local key count_file step_file count threshold threshold_option step action settle

	[ -n "$event" ] || return 1
	check_enabled "$event" || {
		log "event '$event' ignored because check is disabled"
		return 0
	}

	mkdir -p "$STATE_DIR"
	key="$(event_file_name "$event")"
	count_file="$STATE_DIR/$key.count"
	step_file="$STATE_DIR/$key.step"
	count="$(cat "$count_file" 2>/dev/null)"
	step="$(cat "$step_file" 2>/dev/null)"
	count=$(( ${count:-0} + 1 ))
	step="${step:-1}"

	threshold_option="$(fail_count_option "$event")"
	threshold="$(cfg "$threshold_option" 2)"
	[ "$threshold" -gt 0 ] 2>/dev/null || threshold=1

	printf '%s\n' "$count" > "$count_file"
	log "event '$event' count $count/$threshold${detail:+: $detail}"

	[ "$count" -lt "$threshold" ] && return 0

	printf '%s\n' 0 > "$count_file"
	action="$(action_for_event_step "$event" "$step")"
	[ -n "$action" ] || {
		log "event '$event' reached step $step but no action is configured"
		return 0
	}

	log "event '$event' reached threshold, running step $step action '$action'"
	run_action "$action"
	settle="$(cfg recovery_settle_time 60)"
	[ "$settle" -gt 0 ] 2>/dev/null && sleep "$settle"

	step=$((step + 1))
	[ "$step" -gt 5 ] && step=5
	printf '%s\n' "$step" > "$step_file"
}

clear_event() {
	local key

	key="$(event_file_name "$1")"
	rm -f "$STATE_DIR/$key.count" "$STATE_DIR/$key.step"
}

case "$1" in
	event)
		shift
		handle_event "$1" "$2"
		;;
	clear)
		shift
		[ -n "$1" ] && clear_event "$1"
		;;
	reset)
		rm -rf "$STATE_DIR"
		;;
	*)
		printf '%s\n' "Usage: $0 event <name> [detail] | clear <name> | reset" >&2
		exit 1
		;;
esac
