#!/bin/sh

NAME="qtcmsim-failover"
STATE_DIR="/tmp/qtcmsim-failover"
LAST_SWITCH_FILE="$STATE_DIR/last_switch"
LOSS_SINCE_FILE="$STATE_DIR/loss_since"
USAGE_FILE="$STATE_DIR/usage"
LAST_PRIMARY_RETRY_FILE="$STATE_DIR/last_primary_retry"
LAST_FAILED_SIM_FILE="$STATE_DIR/last_failed_sim"
TROUBLESHOOTER="/usr/libexec/qtcm-troubleshooter"

log() {
	logger -t "$NAME" "$*"
}

read_uci() {
	uci -q get "$1" 2>/dev/null
}

cfg() {
	local option="$1"
	local fallback="$2"
	local value

	value="$(read_uci "qtcm.failover.$option")"
	[ -n "$value" ] && printf '%s' "$value" || printf '%s' "$fallback"
}

tcfg() {
	local option="$1"
	local fallback="$2"
	local value

	value="$(read_uci "qtcm.troubleshoot.$option")"
	[ -n "$value" ] && printf '%s' "$value" || printf '%s' "$fallback"
}

sim_enabled() {
	[ "$(read_uci "qtcm.sim${1}.enabled")" = "1" ]
}

active_sim() {
	local sim

	sim="$(read_uci qtcm.main.active_sim)"
	[ "$sim" = "2" ] && printf '2' || printf '1'
}

other_sim() {
	[ "$1" = "1" ] && printf '2' || printf '1'
}

primary_sim() {
	local sim

	sim="$(cfg primary_sim 1)"
	[ "$sim" = "2" ] && printf '2' || printf '1'
}

backup_sim() {
	local sim

	sim="$(cfg backup_sim 2)"
	[ "$sim" = "1" ] && printf '1' || printf '2'
}

json_value() {
	local key="$1"

	sed -n "s/.*\"$key\":\"\\([^\"]*\\)\".*/\\1/p"
}

status_json() {
	/usr/bin/qtcm-status.sh 2>/dev/null
}

troubleshooter_event() {
	local event="$1"
	local detail="$2"

	[ -x "$TROUBLESHOOTER" ] || return 0
	"$TROUBLESHOOTER" event "$event" "$detail" >/dev/null 2>&1 || \
		log "troubleshooter event '$event' failed"
}

troubleshooter_reset() {
	[ -x "$TROUBLESHOOTER" ] || return 0
	"$TROUBLESHOOTER" reset >/dev/null 2>&1
}

now() {
	date +%s
}

absolute_dbm() {
	local dbm="$1"

	case "$dbm" in
		-*) printf '%s' "${dbm#-}" ;;
		[0-9]*) printf '%s' "$dbm" ;;
		*) printf '%s' "" ;;
	esac
}

priority_sequence() {
	local p n value

	for n in 1 2 3 4 5; do
		value="$(cfg "priority_$n" '')"
		[ -n "$value" ] && printf '%s\n' "$value"
	done
}

ping_hosts() {
	local family="$1"
	local hosts="$2"
	local timeout="$3"
	local count=0
	local host cmd

	for host in $hosts; do
		[ -n "$host" ] || continue

		if [ "$family" = "6" ]; then
			cmd="${PING6:-ping6}"
		else
			cmd="ping"
		fi

		if "$cmd" -c 1 -W "$timeout" "$host" >/dev/null 2>&1; then
			count=$((count + 1))
		fi
	done

	printf '%s' "$count"
}

internet_ok_for_sim() {
	local sim="$1"
	local timeout min_ping ip_type ipv4_hosts ipv6_hosts got=0

	[ "$(cfg check_internet_failure "$(cfg check_ping_status 0)")" = "1" ] || return 0

	timeout="$(cfg response_timeout 10)"
	min_ping="$(cfg minimum_ping_responses 1)"
	ip_type="$(read_uci "qtcm.sim${sim}.ip_type")"
	ipv4_hosts="$(read_uci qtcm.failover.ping_ipv4_ips)"
	ipv6_hosts="$(read_uci qtcm.failover.ping_ipv6_ips)"

	case "$ip_type" in
		ipv6) got="$(ping_hosts 6 "$ipv6_hosts" "$timeout")" ;;
		ipv4v6) got=$(( $(ping_hosts 4 "$ipv4_hosts" "$timeout") + $(ping_hosts 6 "$ipv6_hosts" "$timeout") )) ;;
		*) got="$(ping_hosts 4 "$ipv4_hosts" "$timeout")" ;;
	esac

	[ "$got" -ge "$min_ping" ]
}

max_ping_latency() {
	local hosts="$1"
	local timeout="$2"
	local max=0
	local host latency

	for host in $hosts; do
		[ -n "$host" ] || continue
		latency="$(ping -c 1 -W "$timeout" "$host" 2>/dev/null | sed -n 's/.*time=\([0-9][0-9]*\).*/\1/p' | head -n 1)"
		[ -n "$latency" ] || continue
		[ "$latency" -gt "$max" ] && max="$latency"
	done

	printf '%s' "$max"
}

interface_bytes() {
	local iface="$1"
	local rx tx

	[ -n "$iface" ] && [ "$iface" != "Unknown" ] || return 1
	[ -r "/sys/class/net/$iface/statistics/rx_bytes" ] || return 1
	[ -r "/sys/class/net/$iface/statistics/tx_bytes" ] || return 1

	rx="$(cat "/sys/class/net/$iface/statistics/rx_bytes")"
	tx="$(cat "/sys/class/net/$iface/statistics/tx_bytes")"
	printf '%s' "$((rx + tx))"
}

interface_has_ip() {
	local iface="$1"

	[ -n "$iface" ] && [ "$iface" != "Unknown" ] || return 1
	command -v ip >/dev/null 2>&1 || return 0
	ip -o addr show dev "$iface" 2>/dev/null | grep -q ' inet '
}

quota_exceeded() {
	local sim="$1"
	local iface="$2"
	local quota_gb current today state_date state_sim base used limit

	[ "$(cfg check_data_usage 0)" = "1" ] || return 1

	quota_gb="$(cfg "sim${sim}_quota_day" 0)"
	[ "$quota_gb" -gt 0 ] 2>/dev/null || return 1

	current="$(interface_bytes "$iface")" || return 1
	today="$(date +%Y%m%d)"

	if [ -f "$USAGE_FILE" ]; then
		read -r state_date state_sim base < "$USAGE_FILE"
	fi

	if [ "$state_date" != "$today" ] || [ "$state_sim" != "$sim" ] || [ -z "$base" ] || [ "$current" -lt "$base" ]; then
		printf '%s %s %s\n' "$today" "$sim" "$current" > "$USAGE_FILE"
		return 1
	fi

	used=$((current - base))
	limit=$((quota_gb * 1024 * 1024 * 1024))
	[ "$used" -ge "$limit" ]
}

allowed_to_switch() {
	local wait last elapsed

	wait="$(cfg flap_wait 300)"
	last="$(cat "$LAST_SWITCH_FILE" 2>/dev/null)"
	[ -n "$last" ] || return 0

	elapsed=$(($(now) - last))
	[ "$elapsed" -ge "$wait" ]
}

post_switch_settling() {
	local wait last elapsed

	wait="$(cfg post_switch_settle_time 50)"
	[ "$wait" -gt 0 ] 2>/dev/null || return 1

	last="$(cat "$LAST_SWITCH_FILE" 2>/dev/null)"
	[ -n "$last" ] || return 1

	elapsed=$(($(now) - last))
	if [ "$elapsed" -lt "$wait" ]; then
		log "waiting for post-switch settle ${elapsed}/${wait}s before judging SIM"
		return 0
	fi

	return 1
}

call_post_switch_hook() {
	local new_sim="$1"
	local old_sim="$2"
	local reason="$3"
	local iface="$4"
	local signal_dbm="$5"
	local hook

	hook="$(cfg post_switch_hook '')"
	[ -n "$hook" ] || return 0
	[ -x "$hook" ] || {
		log "post switch hook '$hook' is not executable"
		return 0
	}

	NEW_SIM="$new_sim" OLD_SIM="$old_sim" SWITCH_REASON="$reason" ACTIVE_INTERFACE="$iface" SIGNAL_DBM="$signal_dbm" \
		"$hook" "$new_sim" "$old_sim" "$reason" "$iface" "$signal_dbm" >/dev/null 2>&1 || \
		log "post switch hook '$hook' failed for SIM $old_sim -> SIM $new_sim"
}

switch_to_sim() {
	local new_sim="$1"
	local old_sim="$2"
	local reason="$3"
	local iface="$4"
	local signal_dbm="$5"
	local force="$6"

	[ "$new_sim" = "$old_sim" ] && return 0
	sim_enabled "$new_sim" || {
		log "not switching to disabled SIM $new_sim"
		return 1
	}

	if [ "$force" != "1" ] && ! allowed_to_switch; then
		log "switch SIM $old_sim -> $new_sim blocked by flapping protection"
		return 1
	fi

	log "switching SIM $old_sim -> $new_sim: $reason"
	uci -q set "qtcm.main.active_sim=$new_sim"
	uci -q commit qtcm
	printf '%s\n' "$(now)" > "$LAST_SWITCH_FILE"
	rm -f "$LOSS_SINCE_FILE"

	call_post_switch_hook "$new_sim" "$old_sim" "$reason" "$iface" "$signal_dbm"

	if [ "$(cfg restart_qtcm_after_switch 1)" = "1" ] && [ -x /etc/init.d/qtcm ]; then
		/etc/init.d/qtcm restart >/dev/null 2>&1 || log "qtcm restart failed after SIM switch"
	fi
}

try_primary_sim() {
	local current primary settle reason iface signal_dbm json

	primary="$(primary_sim)"
	current="$(active_sim)"

	[ "$current" = "$primary" ] && {
		log "primary SIM $primary already active"
		return 0
	}

	sim_enabled "$primary" || {
		log "primary SIM $primary retry skipped because it is disabled"
		return 1
	}

	json="$(status_json)"
	iface="$(printf '%s' "$json" | json_value interface)"
	signal_dbm="$(printf '%s' "$json" | json_value signal_dbm)"
	reason="${1:-primary retry}"
	settle="$(cfg primary_retry_settle_time 60)"

	printf '%s\n' "$(now)" > "$LAST_PRIMARY_RETRY_FILE"
	switch_to_sim "$primary" "$current" "$reason" "$iface" "$signal_dbm" 1 || return 1
	sleep "$settle"

	if [ "$(cfg primary_retry_check_internet 1)" = "1" ] && ! internet_ok_for_sim "$primary"; then
		log "primary SIM $primary retry failed internet check, switching back to SIM $current"
		switch_to_sim "$current" "$primary" "primary retry failed internet check" "$iface" "$signal_dbm" 1
		return 1
	fi

	log "primary SIM $primary retry accepted"
	return 0
}

maybe_try_primary_sim() {
	local current primary interval last elapsed

	[ "$(cfg enable_primary_failback 0)" = "1" ] || return 0

	primary="$(primary_sim)"
	current="$(active_sim)"
	[ "$current" != "$primary" ] || return 0

	interval="$(cfg primary_retry_interval 3600)"
	last="$(cat "$LAST_PRIMARY_RETRY_FILE" 2>/dev/null)"
	[ -n "$last" ] || last="$(cat "$LAST_SWITCH_FILE" 2>/dev/null)"
	[ -n "$last" ] || last=0

	elapsed=$(($(now) - last))
	[ "$elapsed" -ge "$interval" ] || return 0

	try_primary_sim "scheduled primary failback retry"
}

handle_network_loss_reboot() {
	local failed="$1"
	local threshold since elapsed

	[ "$(cfg enable_network_reboot 0)" = "1" ] || return 0
	threshold="$(cfg reboot_on_network_loss 1800)"

	if [ "$failed" = "1" ]; then
		since="$(cat "$LOSS_SINCE_FILE" 2>/dev/null)"
		if [ -z "$since" ]; then
			printf '%s\n' "$(now)" > "$LOSS_SINCE_FILE"
			return 0
		fi

		elapsed=$(($(now) - since))
		if [ "$elapsed" -ge "$threshold" ]; then
			log "network loss exceeded ${threshold}s, rebooting"
			/sbin/reboot
		fi
	else
		rm -f "$LOSS_SINCE_FILE"
	fi
}

process_failure() {
	local sim="$1"
	local target="$2"
	local reason="$3"
	local event="$4"
	local iface="$5"
	local signal_dbm="$6"
	local last_failed_sim

	last_failed_sim="$(cat "$LAST_FAILED_SIM_FILE" 2>/dev/null)"

	if [ -n "$last_failed_sim" ] && [ "$last_failed_sim" != "$sim" ]; then
		log "SIM $sim failed after SIM $last_failed_sim already failed, sending '$event' to troubleshooter"
		troubleshooter_event "${event:-post_failover_failure}" "$reason"
		return 0
	fi

	if sim_enabled "$target"; then
		if switch_to_sim "$target" "$sim" "$reason" "$iface" "$signal_dbm" 1; then
			printf '%s\n' "$sim" > "$LAST_FAILED_SIM_FILE"
			return 0
		fi

		log "SIM $target is enabled but switch failed, sending '$event' to troubleshooter"
		troubleshooter_event "${event:-post_failover_failure}" "$reason"
		return 0
	fi

	log "SIM $target is disabled, sending '$event' to troubleshooter"
	troubleshooter_event "${event:-post_failover_failure}" "$reason"
}

check_once() {
	local json sim target reason iface signal_dbm signal_abs threshold failed=0 primary backup
	local signal_snr min_snr trigger ip_type ipv4_hosts ipv6_hosts timeout min_ping got latency fail_latency network_status
	local sim_status modem_source failure_event

	json="$(status_json)"
	sim="$(active_sim)"
	primary="$(primary_sim)"
	backup="$(backup_sim)"
	[ "$sim" = "$primary" ] && target="$backup" || target="$primary"
	iface="$(printf '%s' "$json" | json_value interface)"
	signal_dbm="$(printf '%s' "$json" | json_value signal_dbm)"
	signal_snr="$(printf '%s' "$json" | json_value signal_snr)"
	network_status="$(printf '%s' "$json" | json_value network_status)"
	sim_status="$(printf '%s' "$json" | json_value sim_status)"
	modem_source="$(printf '%s' "$json" | json_value modem_source)"
	reason=""

	if post_switch_settling; then
		return 0
	fi

	if [ "$(tcfg check_modem_response 1)" = "1" ] && \
		{ [ "$modem_source" = "No modem AT port detected" ] || [ "$sim_status" = "Unknown" ]; }; then
		failed=1
		failure_event="modem_unresponsive"
		reason="modem AT response unavailable"
	elif [ "$(tcfg check_sim_error 1)" = "1" ] && [ "$sim_status" = "No" ]; then
		failed=1
		failure_event="sim_error"
		reason="SIM error or SIM not inserted"
	elif [ "$(tcfg check_interface_ip 1)" = "1" ] && ! interface_has_ip "$iface"; then
		failed=1
		failure_event="interface_no_ip"
		reason="interface $iface has no IPv4 address"
	elif [ "$(tcfg check_registration 1)" = "1" ] && [ "$network_status" = "No" ]; then
		failed=1
		failure_event="registration_failed"
		reason="network registration failed"
	else
		for trigger in $(priority_sequence); do
			case "$trigger" in
				internet)
					[ "$(cfg check_internet_failure "$(cfg check_ping_status 0)")" = "1" ] || continue
					timeout="$(cfg response_timeout 10)"
					min_ping="$(cfg minimum_ping_responses 1)"
					ip_type="$(read_uci "qtcm.sim${sim}.ip_type")"
					ipv4_hosts="$(read_uci qtcm.failover.ping_ipv4_ips)"
					ipv6_hosts="$(read_uci qtcm.failover.ping_ipv6_ips)"
					got=0

					case "$ip_type" in
						ipv6) got="$(ping_hosts 6 "$ipv6_hosts" "$timeout")" ;;
						ipv4v6) got=$(( $(ping_hosts 4 "$ipv4_hosts" "$timeout") + $(ping_hosts 6 "$ipv6_hosts" "$timeout") )) ;;
						*) got="$(ping_hosts 4 "$ipv4_hosts" "$timeout")" ;;
					esac

					if [ "$got" -lt "$min_ping" ]; then
						failed=1
						failure_event="internet_failure"
						reason="internet failure: ping responses $got below minimum $min_ping"
					fi
					;;
				snr)
					[ "$(cfg check_snr 0)" = "1" ] || continue
					min_snr="$(cfg minimum_snr 5)"
					if [ "$signal_snr" != "Unknown" ] && [ "$signal_snr" -lt "$min_snr" ] 2>/dev/null; then
						failed=1
						failure_event="post_failover_failure"
						reason="SNR ${signal_snr} dB below minimum ${min_snr} dB"
					fi
					;;
				latency)
					[ "$(cfg check_link_performance 0)" = "1" ] || continue
					timeout="$(cfg response_timeout 10)"
					fail_latency="$(cfg failure_latency 450)"
					ipv4_hosts="$(read_uci qtcm.failover.ping_ipv4_ips)"
					latency="$(max_ping_latency "$ipv4_hosts" "$timeout")"

					if [ "$latency" -ge "$fail_latency" ] && [ "$latency" -gt 0 ]; then
						failed=1
						failure_event="post_failover_failure"
						reason="link latency ${latency}ms exceeded ${fail_latency}ms"
					fi
					;;
				quota)
					if quota_exceeded "$sim" "$iface"; then
						failed=1
						failure_event="post_failover_failure"
						reason="daily quota exceeded for SIM $sim"
					fi
					;;
				rssi)
					[ "$(cfg check_signal_strength 1)" = "1" ] || continue
					threshold="$(cfg switch_above_signal 75)"
					signal_abs="$(absolute_dbm "$signal_dbm")"
					if [ -n "$signal_abs" ] && [ "$signal_abs" -gt "$threshold" ]; then
						failed=1
						failure_event="post_failover_failure"
						reason="RSSI ${signal_dbm} dBm below threshold -${threshold} dBm"
					fi
					;;
			esac

			[ "$failed" = "1" ] && break
		done
	fi

	if [ "$failed" = "0" ] && [ "$network_status" = "No" ]; then
		handle_network_loss_reboot 1
	else
		handle_network_loss_reboot "$failed"
	fi

	if [ "$failed" = "1" ]; then
		process_failure "$sim" "$target" "$reason" "$failure_event" "$iface" "$signal_dbm"
	else
		rm -f "$LAST_FAILED_SIM_FILE"
		troubleshooter_reset
		maybe_try_primary_sim
	fi
}

mkdir -p "$STATE_DIR"

case "$1" in
	try-primary)
		try_primary_sim "manual primary retry"
		exit $?
		;;
esac

log "started"

while :; do
	if [ "$(cfg enabled 0)" = "1" ]; then
		check_once
	fi

	sleep "$(cfg link_check_interval 180)"
done
