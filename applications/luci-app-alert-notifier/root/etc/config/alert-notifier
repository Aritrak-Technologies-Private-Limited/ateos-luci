config service 'main'
	option enabled '0'
	option interval '60'
	option dedupe_window '300'
	option spool_dir '/var/run/alert-notifier'
	option event_log '/var/log/alert-notifier.log'

config trigger 'offline'
	option enabled '1'
	option type 'offline'
	option severity 'critical'
	option interface 'wan'
	list host '8.8.8.8'
	list host '1.1.1.1'
	option check_interval '30'
	option timeout '5'
	option failures '3'
	list channel 'email'
	list channel 'sms'

config trigger 'latency'
	option enabled '1'
	option type 'latency'
	option severity 'warning'
	option target '8.8.8.8'
	option latency_high '250'
	option latency_low '150'
	option samples '5'
	list channel 'email'

config trigger 'speed_threshold'
	option enabled '0'
	option type 'speed_threshold'
	option severity 'warning'
	option interface 'wan'
	option direction 'rx'
	option comparator 'below'
	option threshold_kbps '1024'
	option window '60'
	list channel 'email'

config trigger 'sim_tampering'
	option enabled '0'
	option type 'sim_tampering'
	option severity 'critical'
	option at_port 'auto'
	option status_source 'qtcm'
	option gcom_dir '/usr/share/qtcm-gcom'
	option iccid_script 'iccid.qtcmgcom'
	option imsi_script 'imsi.qtcmgcom'
	option imei_script 'imei.qtcmgcom'
	option expected_iccid ''
	option expected_imsi ''
	option expected_imei ''
	list channel 'email'
	list channel 'sms'

config email_api 'email'
	option enabled '0'
	option url ''
	option key ''
	option shared_secret ''
	option verify_ssl '1'
	option connect_timeout '15'
	option max_time '30'
	option from ''

config sms_api 'sms'
	option enabled '0'
	option url ''
	option key ''
	option shared_secret ''
	option verify_ssl '1'
	option connect_timeout '15'
	option max_time '30'
	option sender ''
