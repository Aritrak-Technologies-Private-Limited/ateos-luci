config service 'main'
	option enabled '1'
	option interval '30'
	option timeout '3'
	option discovery 'list'
	option firewall_zone 'wan'
	option status_file '/var/run/internet-healthd/status.json'
	option event_log '/tmp/internet-healthd.log'
	option force_offline_test '1'
	option mwan3_integration '1'
	option failback_to_primary '1'
	list interface 'wan'
	list interface 'cellular'
	list exclude_interface 'loopback'
	list ping_target '1.1.1.1'
	list ping_target '8.8.8.8'
	list dns_target 'openwrt.org'
	list http_url 'http://connectivitycheck.gstatic.com/generate_204'

config recovery 'defaults'
	option failure_threshold '3'
	option repair_default_route '1'
	option route_metric '20'
	option restart_interface '1'
	option restart_modem '0'
	option restart_mwan3 '1'
	option restart_network '0'
	option reboot_router '0'
	list recovery_step 'restart_interface'
	list custom_command ''
