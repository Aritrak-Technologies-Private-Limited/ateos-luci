{
	"luci-app-libreswan": {
		"description": "Grant access to LuCI app Libreswan IPSec",
		"read": {
			"ubus": {
				"libreswan": [
					"*"
				]
			},
			"uci": [
				"libreswan"
			],
			"file": {
				"/etc/ipsec.d": [
					"list"
				],
				"/etc/ipsec.d/luci-*.conf": [
					"read"
				]
			}
		},
		"write": {
			"uci": [
				"libreswan"
			],
			"file": {
				"/etc/ipsec.d/luci-*.conf": [
					"read",
					"write"
				],
				"/usr/sbin/ipsec": [
					"exec"
				]
			}
		}
	}
}
