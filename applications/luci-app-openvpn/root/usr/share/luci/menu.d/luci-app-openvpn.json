	"admin/vpn/openvpn/file/*": {
		"action": {
			"type": "form",
			"path": "openvpn-file"
		},
		"firstchild_ineligible": true
	},

	"admin/vpn/openvpn/upload": {
		"action": {
			"type": "call",
			"module": "luci.controller.openvpn",
			"function": "ovpn_upload"
