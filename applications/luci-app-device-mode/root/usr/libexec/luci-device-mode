#!/bin/sh

set -eu

CONFIG=device_mode
SECTION=main
OUR_STA=luci_device_mode_sta
OUR_AP=luci_device_mode_ap
BACKUP_DIR=/etc/backup/device-mode

get() {
	uci -q get "$CONFIG.$SECTION.$1" 2>/dev/null || printf '%s' "${2:-}"
}

ensure_config() {
	uci -q get "$CONFIG.$SECTION" >/dev/null 2>&1 && return 0

	uci -q batch <<-EOF
		set $CONFIG.$SECTION='config'
		set $CONFIG.$SECTION.mode='router'
		commit $CONFIG
	EOF
}

firewall_zone_ref() {
	local name="$1"

	uci -q show firewall | sed -n "s/^\(firewall\.[^.]*\)\.name='$name'$/\1/p" | sed -n '1p'
}

set_list_network() {
	local zone_ref

	zone_ref="$(firewall_zone_ref "$1")"
	shift

	[ -n "$zone_ref" ] || return 0

	uci -q delete "$zone_ref.network" || true
	while [ "$#" -gt 0 ]; do
		[ -n "$1" ] && uci add_list "$zone_ref.network=$1"
		shift
	done
}

first_wifi_radio() {
	local radio

	radio="$(get wifi_radio '')"
	if [ -n "$radio" ] && uci -q get "wireless.$radio" >/dev/null; then
		printf '%s' "$radio"
		return
	fi

	uci -q show wireless | sed -n "s/^\(wireless\.[^.]*\)=wifi-device$/\1/p" | sed -n 's/^wireless\.//p' | sed -n '1p'
}

wifi_radio_sections() {
	uci -q show wireless | sed -n "s/^\(wireless\.[^.]*\)=wifi-device$/\1/p" | sed -n 's/^wireless\.//p'
}

wifi_radio_phy() {
	local radio="$1"
	local phy path devpath phydev

	phy="$(uci -q get "wireless.$radio.phy" 2>/dev/null || true)"
	[ -n "$phy" ] && {
		printf '%s' "$phy"
		return
	}

	case "$radio" in
		phy*)
			[ -d "/sys/class/ieee80211/$radio" ] && {
				printf '%s' "$radio"
				return
			}
			;;
	esac

	path="$(uci -q get "wireless.$radio.path" 2>/dev/null || true)"
	[ -n "$path" ] || return 0

	for phydev in /sys/class/ieee80211/*; do
		[ -e "$phydev" ] || continue
		devpath="$(readlink -f "$phydev/device" 2>/dev/null || true)"
		case "$devpath" in
			*"$path"*)
				printf '%s' "${phydev##*/}"
				return
				;;
		esac
	done
}

wifi_radio_band() {
	local radio="$1"
	local band hwmode channel phy freqs

	band="$(uci -q get "wireless.$radio.band" 2>/dev/null || true)"
	case "$band" in
		2g|5g|6g|60g)
			printf '%s' "$band"
			return
			;;
	esac

	hwmode="$(uci -q get "wireless.$radio.hwmode" 2>/dev/null || true)"
	case "$hwmode" in
		*11a*|*a)
			printf '5g'
			return
			;;
		*11b*|*11g*|*b|*g)
			printf '2g'
			return
			;;
	esac

	channel="$(uci -q get "wireless.$radio.channel" 2>/dev/null || true)"
	case "$channel" in
		''|auto) ;;
		*[!0-9]*) ;;
		*)
			if [ "$channel" -ge 1 ] && [ "$channel" -le 14 ]; then
				printf '2g'
				return
			fi

			if [ "$channel" -ge 32 ] && [ "$channel" -le 177 ]; then
				printf '5g'
				return
			fi
			;;
	esac

	if command -v iwinfo >/dev/null 2>&1; then
		freqs="$(iwinfo "$radio" freqlist 2>/dev/null || true)"
		echo "$freqs" | grep -Eq '(^|[^0-9])(59|6[0-9]{2,})[0-9][0-9]? MHz|6\.[0-9]+ GHz' && {
			printf '6g'
			return
		}
		echo "$freqs" | grep -Eq '(^|[^0-9])5[0-9]{3} MHz|5\.[0-9]+ GHz' && {
			printf '5g'
			return
		}
		echo "$freqs" | grep -Eq '(^|[^0-9])2[0-9]{3} MHz|2\.[0-9]+ GHz' && {
			printf '2g'
			return
		}
	fi

	phy="$(wifi_radio_phy "$radio")"
	if [ -n "$phy" ] && command -v iw >/dev/null 2>&1; then
		freqs="$(iw phy "$phy" info 2>/dev/null || true)"
		echo "$freqs" | grep -Eq '59[0-9][0-9] MHz|6[0-9]{3} MHz' && {
			printf '6g'
			return
		}
		echo "$freqs" | grep -Eq '5[0-9]{3} MHz' && {
			printf '5g'
			return
		}
		echo "$freqs" | grep -Eq '2[0-9]{3} MHz' && {
			printf '2g'
			return
		}
	fi

	printf 'unknown'
}

list_wifi_radios() {
	local radio

	for radio in $(wifi_radio_sections); do
		printf '%s\t%s\t%s\n' "$radio" "$(wifi_radio_band "$radio")" "$(wifi_radio_phy "$radio")"
	done
}

first_wifi_iface() {
	local mode="$1"

	uci -q show wireless | sed -n "s/^\(wireless\.[^.]*\)\.mode='$mode'$/\1/p" | sed -n '1p'
}

wifi_iface_option() {
	local mode="$1"
	local option="$2"
	local section

	section="$(first_wifi_iface "$mode")"
	[ -n "$section" ] || return 0

	uci -q get "$section.$option" 2>/dev/null || true
}

value_or_default() {
	local value="$1"
	local default="$2"

	if [ -n "$value" ]; then
		printf '%s' "$value"
	else
		printf '%s' "$default"
	fi
}

network_device_option() {
	local iface="$1"

	uci -q get "network.$iface.device" 2>/dev/null ||
		uci -q get "network.$iface.ifname" 2>/dev/null ||
		true
}

delete_our_wifi() {
	uci -q delete "wireless.$OUR_STA" || true
	uci -q delete "wireless.$OUR_AP" || true
}

disable_wifi_ifaces() {
	local section

	for section in $(uci -q show wireless | sed -n "s/^\(wireless\.[^.]*\)=wifi-iface$/\1/p"); do
		uci -q set "$section.disabled=1"
	done
}

backup_configs() {
	local ts

	ts="$(date +%Y%m%d-%H%M%S)"
	mkdir -p "$BACKUP_DIR/$ts"

	for cfg in network wireless dhcp firewall; do
		[ -f "/etc/config/$cfg" ] && cp "/etc/config/$cfg" "$BACKUP_DIR/$ts/$cfg"
	done
}

setup_lan_static() {
	local ipaddr netmask lan_ifname

	ipaddr="$(get lan_ipaddr "$(uci -q get network.lan.ipaddr 2>/dev/null || printf '192.168.1.1')")"
	netmask="$(get lan_netmask "$(uci -q get network.lan.netmask 2>/dev/null || printf '255.255.255.0')")"
	lan_ifname="$(get lan_ifname "$(network_device_option lan)")"

	uci -q set network.lan='interface'
	uci -q set network.lan.proto='static'
	uci -q set network.lan.ipaddr="$ipaddr"
	uci -q set network.lan.netmask="$netmask"

	if [ -n "$lan_ifname" ]; then
		uci -q set network.lan.device="$lan_ifname"
	fi
}

setup_lan_dhcp_client() {
	local lan_ifname

	lan_ifname="$(get lan_ifname "$(network_device_option lan)")"
	uci -q set network.lan='interface'
	uci -q set network.lan.proto='dhcp'
	uci -q delete network.lan.ipaddr || true
	uci -q delete network.lan.netmask || true

	if [ -n "$lan_ifname" ]; then
		uci -q set network.lan.device="$lan_ifname"
	fi
}

enable_lan_dhcp() {
	uci -q set dhcp.lan='dhcp'
	uci -q set dhcp.lan.interface='lan'
	uci -q set dhcp.lan.start='100'
	uci -q set dhcp.lan.limit='150'
	uci -q set dhcp.lan.leasetime='12h'
	uci -q delete dhcp.lan.ignore || true
}

disable_lan_dhcp() {
	uci -q set dhcp.lan='dhcp'
	uci -q set dhcp.lan.interface='lan'
	uci -q set dhcp.lan.ignore='1'
}

setup_wan_dhcp() {
	local wan_ifname

	wan_ifname="$(get wan_ifname "$(network_device_option wan)")"
	uci -q set network.wan='interface'
	uci -q set network.wan.proto='dhcp'

	if [ -n "$wan_ifname" ]; then
		uci -q set network.wan.device="$wan_ifname"
	fi

	uci -q delete network.wwan || true
	set_list_network wan wan wan6
}

disable_wan() {
	uci -q set network.wan='interface'
	uci -q set network.wan.proto='none'
	uci -q delete network.wwan || true
	set_list_network wan
}

setup_wwan() {
	uci -q set network.wwan='interface'
	uci -q set network.wwan.proto='dhcp'
	set_list_network wan wan wan6 wwan
}

setup_sta() {
	local radio ssid encryption key current_encryption

	radio="$(first_wifi_radio)"
	ssid="$(get uplink_ssid "$(wifi_iface_option sta ssid)")"
	current_encryption="$(wifi_iface_option sta encryption)"
	encryption="$(get uplink_encryption "$(value_or_default "$current_encryption" psk2)")"
	key="$(get uplink_key "$(wifi_iface_option sta key)")"

	[ -n "$radio" ] || {
		echo "No wireless radio found." >&2
		return 1
	}

	[ -n "$ssid" ] || {
		echo "Uplink SSID is required for this mode." >&2
		return 1
	}

	uci -q set "wireless.$radio.disabled=0"
	uci -q set "wireless.$OUR_STA=wifi-iface"
	uci -q set "wireless.$OUR_STA.device=$radio"
	uci -q set "wireless.$OUR_STA.mode=sta"
	uci -q set "wireless.$OUR_STA.network=wwan"
	uci -q set "wireless.$OUR_STA.ssid=$ssid"
	uci -q set "wireless.$OUR_STA.encryption=$encryption"
	uci -q set "wireless.$OUR_STA.disabled=0"

	if [ "$encryption" = "none" ]; then
		uci -q delete "wireless.$OUR_STA.key" || true
	else
		uci -q set "wireless.$OUR_STA.key=$key"
	fi
}

setup_ap() {
	local radio ssid encryption key current_ssid current_encryption

	radio="$(first_wifi_radio)"
	current_ssid="$(wifi_iface_option ap ssid)"
	current_encryption="$(wifi_iface_option ap encryption)"
	ssid="$(get ap_ssid "$(value_or_default "$current_ssid" OpenWrt)")"
	encryption="$(get ap_encryption "$(value_or_default "$current_encryption" none)")"
	key="$(get ap_key "$(wifi_iface_option ap key)")"

	[ -n "$radio" ] || return 0

	uci -q set "wireless.$radio.disabled=0"
	uci -q set "wireless.$OUR_AP=wifi-iface"
	uci -q set "wireless.$OUR_AP.device=$radio"
	uci -q set "wireless.$OUR_AP.mode=ap"
	uci -q set "wireless.$OUR_AP.network=lan"
	uci -q set "wireless.$OUR_AP.ssid=$ssid"
	uci -q set "wireless.$OUR_AP.encryption=$encryption"
	uci -q set "wireless.$OUR_AP.disabled=0"

	if [ "$encryption" = "none" ]; then
		uci -q delete "wireless.$OUR_AP.key" || true
	else
		uci -q set "wireless.$OUR_AP.key=$key"
	fi
}

apply_router() {
	delete_our_wifi
	disable_wifi_ifaces
	setup_lan_static
	enable_lan_dhcp
	setup_wan_dhcp
	setup_ap
}

apply_wireless_client() {
	delete_our_wifi
	disable_wifi_ifaces
	setup_lan_static
	enable_lan_dhcp
	setup_wwan
	setup_sta
}

apply_wifi_repeater() {
	delete_our_wifi
	disable_wifi_ifaces
	setup_lan_static
	enable_lan_dhcp
	setup_wwan
	setup_sta
	setup_ap
}

apply_dumb_lan() {
	delete_our_wifi
	disable_wifi_ifaces
	disable_wan
	disable_lan_dhcp

	if [ "$(get dumb_lan_proto static)" = "dhcp" ]; then
		setup_lan_dhcp_client
	else
		setup_lan_static
	fi
}

restart_network() {
	/etc/init.d/dnsmasq restart >/dev/null 2>&1 || true
	/etc/init.d/odhcpd restart >/dev/null 2>&1 || true
	/etc/init.d/firewall restart >/dev/null 2>&1 || true
	wifi reload >/dev/null 2>&1 || wifi >/dev/null 2>&1 || true
	/etc/init.d/network reload >/dev/null 2>&1 || /etc/init.d/network restart >/dev/null 2>&1 || true
}

apply_mode() {
	local mode

	ensure_config
	mode="$(get mode router)"
	backup_configs

	case "$mode" in
		router)
			apply_router
			;;
		wireless_client)
			apply_wireless_client
			;;
		wifi_repeater)
			apply_wifi_repeater
			;;
		dumb_lan)
			apply_dumb_lan
			;;
		*)
			echo "Unsupported operating mode: $mode" >&2
			return 1
			;;
	esac

	uci -q commit network
	[ ! -f /etc/config/wireless ] || uci -q commit wireless
	uci -q commit dhcp
	uci -q commit firewall
	restart_network

	echo "Applied operating mode: $mode"
}

case "${1:-}" in
	init)
		ensure_config
		;;
	radios)
		list_wifi_radios
		;;
	apply)
		apply_mode
		;;
	*)
		echo "Usage: $0 init|radios|apply" >&2
		exit 1
		;;
esac
